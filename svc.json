{
  "schema_version": 4,
  "dev": {
    "targets": {
      "database": {
        "poll_interval": 1,
        "probe": {
          "argv": [
            "pdm",
            "run",
            "dev:database",
            "probe",
            "${dev.instance}"
          ],
          "cwd": ".",
          "kind": "exec",
          "output_limit": 2048,
          "timeout": 8
        },
        "provision": {
          "argv": [
            "pdm",
            "run",
            "dev:database",
            "ensure",
            "${dev.instance}"
          ],
          "cwd": ".",
          "env": {
            "INKCRE_DATABASE_PROVIDER": "local"
          },
          "kind": "exec",
          "mode": "run"
        },
        "readiness_timeout": 600,
        "scope": "worktree",
        "stop": {
          "argv": [
            "pdm",
            "run",
            "dev:database",
            "stop",
            "${dev.instance}"
          ],
          "cwd": ".",
          "kind": "exec",
          "timeout": 300
        }
      }
    }
  }
}
